# ALIEV.IO configuration — copy to .env (never commit .env). Placeholders only.
# Real values belong in the deployment environment / secret store.

APP_ENV=production            # production | local | testing
APP_DEBUG=false               # true only in local development; never in production
APP_URL=https://aliev.io      # canonical origin, no trailing slash
APP_KEY=                      # >= 32 random chars; generate with `php scripts/generate-key.php`
APP_TIMEZONE=UTC

# Reverse proxy / load balancer addresses whose X-Forwarded-* headers are trusted
# (comma separated IPs or CIDRs). Empty = trust nothing, use REMOTE_ADDR.
TRUSTED_PROXIES=
FORCE_HTTPS=true              # redirect http -> https in production

# Logging: file | stderr
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Contact / lead notifications: telegram | log | null
NOTIFY_DRIVER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_TIMEOUT_SECONDS=4

# Database (MariaDB/MySQL): accounts (Auth) and job postings (Careers). Docker dev sets these in compose.yaml.
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aliev
DB_USERNAME=aliev
DB_PASSWORD=                  # set a strong secret in the deployment environment

# Development only: load fictional sample data from database/seeds on migrate (ignored in production)
SEED_DEV_DATA=false

# Accounts: the Auth pages and the account entry points in the UI are enabled only when true
AUTH_ENABLED=false

# Main page
INTERGRAM_CHAT_ID=            # support chat; empty = the chat widget is not loaded
# Contact page map (public pk. token, URL-restricted in the Mapbox dashboard); empty = the map panel stays empty
MAPBOX_TOKEN=
DOCS_URL=
SOCIAL_INSTAGRAM=https://www.instagram.com/aev.platforms/
SOCIAL_TELEGRAM=https://t.me/aev_platforms
SOCIAL_TELEGRAM_NEWS=https://t.me/s/aev_platforms
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
QIRIMTALK_URL=

# Crypto ticker (/api/prices): providers tried in order. A CoinGecko key is optional (keyless works).
MARKET_PROVIDERS=coingecko,coinbase
COINGECKO_API_KEY=
MARKET_TTL_SECONDS=60
MARKET_MAX_STALE_SECONDS=21600
MARKET_AEVD_FOLLOWS_USDC=true
