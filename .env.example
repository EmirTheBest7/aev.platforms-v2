# ALIEV.IO configuration — copy to .env for local use (never commit .env). Placeholders only.
# In production set these as real environment variables / secrets of the platform (they win over any .env file).
# Comments are on their own lines on purpose: some tools read an inline "# note" as part of the value.
#
# Legend:  [REQUIRED] production will not run correctly without it
#          [REQUIRED-IF] required when the named situation applies
#          [OPTIONAL] has a safe default; empty = feature off

# ── Application ──────────────────────────────────────────────────────────────

# [REQUIRED] production | local | testing. Debug output is forced off in production.
APP_ENV=production
# Never true in production (ignored there anyway).
APP_DEBUG=false
# [REQUIRED] Public origin, https, no trailing slash. Drives canonical/OG URLs, HSTS, the Secure session cookie and the HTTPS redirect.
# Placeholder: the production domain (aliev.io) is not registered yet.
APP_URL=https://aliev.io
# [REQUIRED] At least 32 random characters (signed form tokens throw without it). Generate: php scripts/generate-key.php
APP_KEY=
APP_TIMEZONE=UTC

# ── HTTPS / reverse proxy ────────────────────────────────────────────────────

# [REQUIRED-IF TLS is terminated by a proxy or load balancer] Comma separated IPs/CIDRs of that proxy.
# Left empty while FORCE_HTTPS=true behind such a proxy, every request looks like plain HTTP and redirects forever.
TRUSTED_PROXIES=
# Redirect http -> https in production. Keep true; set TRUSTED_PROXIES as above when a proxy sits in front.
FORCE_HTTPS=true

# ── Logging ──────────────────────────────────────────────────────────────────

# file | stderr | null. Use stderr in containers.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ── Database (MariaDB/MySQL): accounts (Auth) and job postings (Careers) ─────

# [REQUIRED] Docker development sets these in compose.yaml; never use its dev-only password in production.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aliev
DB_USERNAME=aliev
# [REQUIRED] A strong secret, set in the deployment environment.
DB_PASSWORD=
# Apply the schema on container start (otherwise run `php scripts/migrate.php` once per release). Safe to repeat.
AUTO_MIGRATE=false
# Development only: loads fictional sample jobs from database/seeds. Ignored in production.
SEED_DEV_DATA=false

# ── Contact / lead notifications ─────────────────────────────────────────────

# [REQUIRED for notifications] telegram | log | null. With "log" the leads are only stored in storage/leads and logged.
NOTIFY_DRIVER=log
# [REQUIRED-IF NOTIFY_DRIVER=telegram] Create a NEW bot; the legacy bot token is compromised and must stay revoked.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_TIMEOUT_SECONDS=4

# ── Accounts ─────────────────────────────────────────────────────────────────

# [OPTIONAL] The Auth pages and the account entry points in the UI are enabled only when true.
AUTH_ENABLED=false

# ── Legal pages (/privacy, /imprint) ─────────────────────────────────────────

# [REQUIRED before launch] Operator / controller details shown on /imprint. Nothing is invented: while a required
# value is empty the page shows "To be provided by the owner" and stays out of search engines.
# The Privacy Policy text itself is written in config/legal.php. See docs/LEGAL.md.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_REGISTRATION_ID=
# [OPTIONAL] shown only when set.
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER_ENTRY=
LEGAL_VAT_ID=

# ── Main page and integrations (all optional) ────────────────────────────────

# Intergram support chat (third party, relays messages to Telegram). Empty = the chat widget is not loaded.
INTERGRAM_CHAT_ID=
# Contact page map: a public pk. token, URL-restricted to the site in the Mapbox dashboard. Empty = the map panel stays empty.
MAPBOX_TOKEN=
# Empty = the built-in /home/_api/Docs/
DOCS_URL=
SOCIAL_INSTAGRAM=https://www.instagram.com/aev.platforms/
SOCIAL_TELEGRAM=https://t.me/aev_platforms
SOCIAL_TELEGRAM_NEWS=https://t.me/s/aev_platforms
# Empty = the control keeps its place and shows the "coming soon" notice.
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=

# ── Crypto ticker (/api/prices) ──────────────────────────────────────────────

# Providers are tried in order. A CoinGecko key is optional (keyless works).
MARKET_PROVIDERS=coingecko,coinbase
COINGECKO_API_KEY=
MARKET_TTL_SECONDS=60
MARKET_MAX_STALE_SECONDS=21600
MARKET_AEVD_FOLLOWS_USDC=true
