# ALIEV.IO configuration — copy to .env (never commit .env). Placeholders only.
# Real values belong in the deployment environment / secret store.

APP_ENV=production            # production | local | testing
APP_DEBUG=false               # true only in local development; never in production
APP_URL=https://aliev.io      # canonical origin, no trailing slash
APP_KEY=                      # >= 32 random chars; generate with `php scripts/generate-key.php`
APP_TIMEZONE=UTC

# Reverse proxy / load balancer addresses whose X-Forwarded-* headers are trusted
# (comma separated IPs or CIDRs). Empty = trust nothing, use REMOTE_ADDR.
TRUSTED_PROXIES=
FORCE_HTTPS=true              # redirect http -> https in production

# Logging: file | stderr
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Contact / lead notifications: telegram | log | null
NOTIFY_DRIVER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_TIMEOUT_SECONDS=4

# Database (only needed once the staff account area is enabled; see docs/ARCHITECTURE.md)
DB_DRIVER=mysql               # mysql | pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
