# ============================================================================
# ALIEV.IO .gitignore - Comprehensive ignore patterns
# ============================================================================

# ENVIRONMENT & SECRETS
.env
.env.local
.env.*.local
*.key
*.pem

# OPERATING SYSTEM
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.icloud

# IDE & EDITOR
.idea/
.vscode/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
.project
.classpath

# PHP & COMPOSER
/vendor/
*.phar

# NODE.JS
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# PYTHON
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/

# BUILD & RUNTIME
/storage/*
!/storage/.gitkeep
!/storage/logs/
/storage/logs/*
!/storage/logs/.gitkeep
public/build/
.phpunit.cache/
.php-cs-fixer.cache
.phpstan.cache/
dist/
build/
*.log
logs/

# TEMPORARY FILES
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~
.~*

# DATABASE
*.sqlite
*.db
*.sql
!init.sql

# CACHING
.cache/
cache/
*.cache

# OSX BUNDLES
*.app
*.dSYM/

# LEGACY AUDIT SOURCE (migration reference only, never part of production tree)
/aev.platforms-master/

# RUNTIME USER DATA (leads, rate-limit state) — never commit
uploads/*

# TEST COVERAGE
coverage/
.coverage

# Cleaned source for the agency rebuild (read-only input; nested git repo, contains legacy secrets in its tree/history)
/aev-new/
