parameters:
    level: 8
    paths:
        - core
        - website
        - api
        - config
        - routes
        - public/index.php
    excludePaths:
        # Plain-PHP templates receive their variables at render time; they are exercised by tests/Feature.
        - resources/views
        - core/auth/web/views
        - website/home/views
        - website/careers/views
        - website/contact/views
        - website/downloads/views
