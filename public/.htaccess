# Apache rules for hosts that serve public/ without docker/apache/vhost.conf (same logic, see that file).
Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known/)" - [R=404,L]
  RewriteRule ^index\.php$ - [L]
  RewriteRule \.(php|phtml|phar|inc|sql|md|log|ini|env|bak|dist)$ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|svg|png|ico|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
